# Copie para .env (que NÃO vai para o git) e preencha. Usado pelo Kamal no deploy
# (config/deploy.yml e .kamal/secrets). Veja docs/DEPLOY.md.

# --- Servidor e domínio ---
KAMAL_SERVER_IP=203.0.113.10
APP_HOST=zen.seudominio.com.br

# --- Registry de imagens ---
KAMAL_IMAGE=sua-conta/zen_gastronomy
KAMAL_REGISTRY_SERVER=docker.io
KAMAL_REGISTRY_USERNAME=sua-conta
KAMAL_REGISTRY_PASSWORD=

# --- Banco (Postgres no próprio servidor) ---
# Gere com: openssl rand -hex 32
DATABASE_PASSWORD=

# --- E-mail (recuperação de senha) ---
SMTP_ADDRESS=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_FROM="Zen Gastronomy <nao-responda@seudominio.com.br>"

# --- CORS (vazio = nenhuma origem externa; o app não tem API) ---
CORS_ORIGINS=
