# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# Os valores abaixo vêm do ambiente (exporte-os ou use um .env local, que não vai para o git).
# Exemplo com 1Password:
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY DATABASE_PASSWORD)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})

# Token de acesso ao registry de imagens (Docker Hub, GHCR...)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Improve security by using a password manager. Never check config/master.key into git!
RAILS_MASTER_KEY=$(cat config/master.key)

# Senha do Postgres: a mesma para o container do banco e para o app
POSTGRES_PASSWORD=$DATABASE_PASSWORD
ZEN_GASTRONOMY_DATABASE_PASSWORD=$DATABASE_PASSWORD

# Credenciais SMTP (recuperação de senha)
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
