<% content_for :title, "Saída de estoque · Zen Gastronomy" %>
<%= render "partials/page_header", title: "Saída de estoque", subtitle: "Consumo, perdas e vencidos (não gera lançamento no financeiro)" %>
<%= render "partials/stock_tabs" %>

<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
  <div class="max-w-xl rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <%= form_with model: @output, url: stock_outputs_path, class: "space-y-6" do |f| %>
      <%= render "partials/form_errors", record: @output %>

      <div>
        <%= f.label :product_id, "Produto", class: stock_label_class %>
        <div class="mt-2">
          <%= f.select :product_id,
                current_company.products.active.ordered.map { |p| ["#{p.name} — #{qty(p.quantity)} #{p.unit} em estoque", p.id] },
                { prompt: "Selecione o produto" }, required: true, class: stock_input_class %>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <%= f.label :quantity, "Quantidade", class: stock_label_class %>
          <div class="mt-2">
            <%= f.text_field :quantity, value: (@output.quantity ? decimal_field_value(@output.quantity.abs, precision: 3) : nil),
                  inputmode: "decimal", autocomplete: "off", required: true, class: stock_input_class %>
          </div>
        </div>
        <div>
          <%= f.label :reason, "Motivo", class: stock_label_class %>
          <div class="mt-2"><%= f.select :reason, StockMovement::REASONS.map { |key, label| [label, key] }, {}, class: stock_input_class %></div>
        </div>
      </div>
      <div>
        <%= f.label :notes, "Observações", class: stock_label_class %>
        <div class="mt-2"><%= f.textarea :notes, rows: 2, class: stock_input_class %></div>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to "Cancelar", stock_home_path, class: stock_secondary_button %>
        <%= f.submit "Registrar saída", class: stock_primary_button %>
      </div>
    <% end %>
  </div>
</div>
