<% input_class = "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
<% label_class = "block text-sm/6 font-medium text-gray-900" %>
<% content_for :title, "Novo membro · Zen Gastronomy" %>

<%= render "partials/page_header", title: "Novo membro", subtitle: "A pessoa entra com o e-mail e a senha definidos aqui e pode trocar a senha no Perfil." %>

<main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
  <div class="max-w-xl rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <%= form_with model: @member, url: team_members_path, scope: :user, class: "space-y-6" do |f| %>
      <%= render "partials/form_errors", record: @member %>

      <div>
        <%= f.label :username, "Nome", class: label_class %>
        <div class="mt-2"><%= f.text_field :username, required: true, autofocus: true, class: input_class %></div>
      </div>

      <div>
        <%= f.label :email, "E-mail", class: label_class %>
        <div class="mt-2"><%= f.email_field :email, required: true, autocomplete: "off", class: input_class %></div>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <%= f.label :password, "Senha inicial", class: label_class %>
          <div class="mt-2"><%= f.password_field :password, required: true, autocomplete: "new-password", class: input_class %></div>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmar senha", class: label_class %>
          <div class="mt-2"><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: input_class %></div>
        </div>
      </div>

      <div>
        <%= f.label :role_id, "Perfil", class: label_class %>
        <div class="mt-2">
          <%= f.collection_select :role_id, @roles, :id, :name, {}, required: true, class: input_class %>
        </div>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to "Cancelar", team_members_path, class: "rounded-md bg-white px-3 py-2 text-center text-sm font-semibold text-gray-900 outline-1 outline-gray-300 hover:bg-gray-50" %>
        <%= f.submit "Adicionar à equipe", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>
</main>
