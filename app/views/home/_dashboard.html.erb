<%# Cores por entidade (validadas para daltonismo): entradas = azul, despesas = laranja. %>
<% income_color = "#2a78d6" %>
<% expense_color = "#eb6834" %>
<% series = summary.monthly_series(months: 6) %>

<header class="relative bg-white shadow-sm">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Dashboard</h1>
    <nav class="flex items-center justify-between gap-2 sm:justify-end" aria-label="Selecionar mês">
      <%= link_to root_path(month: summary.previous_month.strftime("%Y-%m")), class: "rounded-md p-2 text-slate-600 outline-1 -outline-offset-1 outline-gray-300 hover:bg-gray-50", aria: { label: "Mês anterior" } do %>
        <svg viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.83 10l3.94 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z" clip-rule="evenodd"/></svg>
      <% end %>
      <span class="min-w-40 text-center text-sm font-semibold text-slate-800"><%= summary.month_label %></span>
      <% if summary.current_month? %>
        <span class="rounded-md p-2 text-slate-300 outline-1 -outline-offset-1 outline-gray-200" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.17 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/></svg>
        </span>
      <% else %>
        <%= link_to root_path(month: summary.next_month.strftime("%Y-%m")), class: "rounded-md p-2 text-slate-600 outline-1 -outline-offset-1 outline-gray-300 hover:bg-gray-50", aria: { label: "Próximo mês" } do %>
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.17 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/></svg>
        <% end %>
      <% end %>
    </nav>
  </div>
</header>

<main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
  <%# Indicadores do mês %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <%= render "home/stat_tile", label: "Entradas no mês", value: summary.income_total, change: summary.change(:income_total), swatch: income_color %>
    <%= render "home/stat_tile", label: "Gasto no mês", value: summary.expense_total, change: summary.change(:expense_total), swatch: expense_color %>
    <%= render "home/stat_tile", label: "Resultado do mês", value: summary.result, hint: (summary.result.negative? ? "Despesas maiores que as entradas" : "Entradas menos despesas") %>
    <%= render "home/stat_tile", label: "Saldo atual em contas", value: summary.total_balance, hint: "Soma de todas as contas" %>
  </div>

  <%# Entradas x despesas nos últimos 6 meses %>
  <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <h2 class="text-base font-semibold text-slate-800">Entradas e despesas</h2>
    <p class="text-xs text-slate-500">Últimos 6 meses até <%= summary.month_label.downcase %> · transferências entre contas não entram</p>
    <% if series.any? { |m| m[:income].positive? || m[:expense].positive? } %>
      <% chart_data = { labels: series.map { |m| m[:label] },
                        datasets: [ { label: "Entradas", data: series.map { |m| m[:income].to_f }, backgroundColor: income_color },
                                    { label: "Despesas", data: series.map { |m| m[:expense].to_f }, backgroundColor: expense_color } ] } %>
      <div class="relative mt-4 h-64 w-full sm:h-80">
        <%= tag.canvas role: "img", aria: { label: "Entradas e despesas por mês nos últimos 6 meses" },
              data: { controller: "money-chart", money_chart_type_value: "bar", money_chart_data_value: chart_data.to_json } %>
      </div>
      <details class="mt-3 text-sm">
        <summary class="cursor-pointer text-xs font-semibold text-indigo-600 hover:text-indigo-500">Ver dados</summary>
        <div class="overflow-x-auto">
          <table class="mt-2 w-full text-left">
            <thead>
              <tr class="text-xs text-slate-500">
                <th class="py-1.5 pr-2 font-normal">Mês</th>
                <th class="py-1.5 pr-2 text-right font-normal">Entradas</th>
                <th class="py-1.5 pr-2 text-right font-normal">Despesas</th>
                <th class="py-1.5 text-right font-normal">Resultado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% series.reverse_each do |m| %>
                <tr>
                  <td class="py-1.5 pr-2 text-slate-700"><%= m[:label] %></td>
                  <td class="py-1.5 pr-2 text-right whitespace-nowrap text-slate-900"><%= brl(m[:income]) %></td>
                  <td class="py-1.5 pr-2 text-right whitespace-nowrap text-slate-900"><%= brl(m[:expense]) %></td>
                  <td class="py-1.5 text-right whitespace-nowrap font-medium text-slate-900"><%= brl(m[:income] - m[:expense]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </details>
    <% else %>
      <p class="py-12 text-center text-sm text-slate-500">
        Nenhuma entrada ou despesa nos últimos 6 meses.
        <%= link_to "Lançar uma transação", financial_index_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
      </p>
    <% end %>
  </section>

  <%# Composição do mês %>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <%= render "home/ranked_chart", title: "Despesas por categoria", subtitle: summary.month_label,
          rows: summary.expenses_by_category, color: expense_color, empty: "Nenhuma despesa neste mês." %>
    <%= render "home/ranked_chart", title: "Entradas por forma de recebimento", subtitle: summary.month_label,
          rows: summary.income_by_subcategory, color: income_color, empty: "Nenhuma entrada neste mês." %>
  </div>
</main>
