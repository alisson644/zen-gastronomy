<section id="recursos" class="scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-indigo-600">Recursos</p>
      <h2 class="mt-2 text-balance text-3xl font-bold tracking-tight sm:text-4xl">Tudo o que o financeiro do seu restaurante precisa. Nada que ele não precise.</h2>
      <p class="mt-4 text-slate-600">Comece a usar em minutos: sua conta já nasce com o plano de contas configurado.</p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% features.each do |title, text, icon| %>
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <span class="flex size-10 items-center justify-center rounded-lg bg-indigo-600 text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>" /></svg>
          </span>
          <h3 class="mt-4 font-semibold text-slate-900"><%= title %></h3>
          <p class="mt-2 text-sm text-slate-600"><%= text %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
