<%
  plans = [
    { name: "Essencial", pitch: "Para quem quer sair da planilha hoje.", monthly: 79, yearly: 66, featured: false,
      items: [ "1 empresa", "Até 2 usuários", "Lançamentos ilimitados", "Plano de contas pronto", "Dashboard mensal" ] },
    { name: "Profissional", pitch: "Para o restaurante que quer crescer com números na mão.", monthly: 149, yearly: 124, featured: true,
      items: [ "Tudo do Essencial", "Até 10 usuários", "Perfis e permissões personalizados", "Comparativos e histórico de 6 meses", "Suporte prioritário via WhatsApp" ] },
    { name: "Rede", pitch: "Para grupos com várias unidades.", monthly: 299, yearly: 249, featured: false,
      items: [ "Tudo do Profissional", "Múltiplas unidades", "Usuários ilimitados", "Implantação assistida", "Gerente de conta dedicado" ] }
  ]
%>
<section id="planos" class="scroll-mt-20 bg-slate-50 py-20 sm:py-28" data-controller="pricing-toggle">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-indigo-600">Planos</p>
      <h2 class="mt-2 text-balance text-3xl font-bold tracking-tight sm:text-4xl">Menos que um prato por dia para ter o controle total do seu caixa</h2>
      <p class="mt-4 text-slate-600">Teste qualquer plano por 14 dias, sem cartão. Se não for para você, é só não continuar.</p>
    </div>

    <div class="mt-10 flex justify-center">
      <div class="inline-flex rounded-full bg-white p-1 text-sm font-semibold ring-1 ring-slate-200" role="group" aria-label="Período de cobrança">
        <button type="button" data-pricing-toggle-target="option" data-period="monthly" data-action="pricing-toggle#select" aria-pressed="true"
                class="rounded-full px-4 py-1.5 text-slate-600 aria-pressed:bg-indigo-600 aria-pressed:text-white">Mensal</button>
        <button type="button" data-pricing-toggle-target="option" data-period="yearly" data-action="pricing-toggle#select" aria-pressed="false"
                class="rounded-full px-4 py-1.5 text-slate-600 aria-pressed:bg-indigo-600 aria-pressed:text-white">Anual <span class="ml-1 rounded-full bg-emerald-100 px-1.5 py-0.5 text-xs text-emerald-700">2 meses grátis</span></button>
      </div>
    </div>

    <div class="mx-auto mt-12 grid max-w-md gap-8 lg:max-w-none lg:grid-cols-3">
      <% plans.each do |plan| %>
        <div class="relative flex flex-col rounded-2xl p-8 <%= plan[:featured] ? "bg-slate-900 text-white shadow-2xl ring-2 ring-indigo-500 lg:-my-4 lg:py-12" : "bg-white shadow-sm ring-1 ring-slate-200" %>">
          <% if plan[:featured] %>
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-indigo-500 px-3 py-1 text-xs font-semibold text-white">Mais escolhido</span>
          <% end %>
          <h3 class="text-lg font-semibold <%= plan[:featured] ? "text-indigo-300" : "text-indigo-600" %>"><%= plan[:name] %></h3>
          <p class="mt-2 text-sm <%= plan[:featured] ? "text-slate-300" : "text-slate-600" %>"><%= plan[:pitch] %></p>
          <p class="mt-6 flex items-baseline gap-x-1">
            <span class="text-4xl font-bold tracking-tight" data-pricing-toggle-target="price" data-period="monthly">R$ <%= plan[:monthly] %></span>
            <span class="text-4xl font-bold tracking-tight" data-pricing-toggle-target="price" data-period="yearly" hidden>R$ <%= plan[:yearly] %></span>
            <span class="text-sm <%= plan[:featured] ? "text-slate-400" : "text-slate-500" %>">/mês</span>
          </p>
          <p class="mt-1 h-4 text-xs <%= plan[:featured] ? "text-slate-400" : "text-slate-500" %>">
            <span data-pricing-toggle-target="price" data-period="yearly" hidden>cobrado anualmente: <%= brl(plan[:yearly] * 12) %></span>
          </p>
          <%= link_to "Começar teste grátis", new_user_registration_path,
                class: "mt-8 block rounded-md px-3 py-2.5 text-center text-sm font-semibold shadow-sm #{plan[:featured] ? "bg-indigo-500 text-white hover:bg-indigo-400" : "bg-white text-indigo-600 ring-1 ring-indigo-200 hover:ring-indigo-300"}" %>
          <div class="mt-8">
            <%= render "home/landing/check_list", items: plan[:items], css: plan[:featured] ? "text-slate-200" : "text-slate-600" %>
          </div>
        </div>
      <% end %>
    </div>
    <p class="mt-10 text-center text-xs text-slate-400">Preços ilustrativos, sujeitos a alteração.</p>
  </div>
</section>
