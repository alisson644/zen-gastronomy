<header class="sticky top-0 z-50 border-b border-slate-200/60 bg-white/80 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8" aria-label="Principal">
    <%= link_to root_path, class: "shrink-0" do %>
      <span class="sr-only">Zen Gastronomy</span>
      <%= image_tag("logo02.png", alt: "Zen Gastronomy", class: "h-8 w-auto sm:h-9") %>
    <% end %>
    <div class="hidden items-center gap-x-8 text-sm font-medium text-slate-600 lg:flex">
      <a href="#recursos" class="hover:text-indigo-600">Recursos</a>
      <a href="#como-funciona" class="hover:text-indigo-600">Como funciona</a>
      <a href="#planos" class="hover:text-indigo-600">Planos</a>
      <a href="#duvidas" class="hover:text-indigo-600">Dúvidas</a>
    </div>
    <div class="flex items-center gap-x-3 sm:gap-x-5">
      <%= link_to "Entrar", new_user_session_path, class: "text-sm font-semibold text-slate-700 hover:text-indigo-600" %>
      <%= link_to "Começar grátis", new_user_registration_path, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    </div>
  </nav>
</header>
