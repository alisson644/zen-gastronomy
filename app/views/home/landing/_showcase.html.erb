<% income = "#2a78d6" %>
<% expense = "#eb6834" %>
<section id="como-funciona" class="scroll-mt-20 bg-slate-50 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl space-y-24 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-indigo-600">Como funciona</p>
      <h2 class="mt-2 text-balance text-3xl font-bold tracking-tight sm:text-4xl">Do caixa ao lucro, em três telas</h2>
    </div>

    <%# 1. Lançamentos %>
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h3 class="text-2xl font-bold tracking-tight">Lançamentos em segundos</h3>
        <p class="mt-4 text-slate-600">Registrou uma venda no Pix ou pagou o fornecedor de hortifruti? Dois cliques e está lançado — e o saldo da conta já foi atualizado.</p>
        <div class="mt-6"><%= render "home/landing/check_list", items: [ "Entradas, saídas e transferências entre contas", "Valores no formato brasileiro, do jeito que você digita", "Categoria preenchida automaticamente pela subcategoria" ] %></div>
      </div>
      <%= render layout: "home/landing/browser_frame", locals: { url: "/financial" } do %>
        <div class="p-4 sm:p-5">
          <div class="flex items-center justify-between">
            <p class="font-semibold text-slate-900">Movimentações</p>
            <span class="rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-semibold text-white">+ Nova</span>
          </div>
          <div class="mt-3 overflow-hidden rounded-lg border border-slate-200 bg-white">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-500"><tr><th class="px-3 py-2 font-medium">Data</th><th class="px-3 py-2 font-medium">Descrição</th><th class="hidden px-3 py-2 font-medium sm:table-cell">Conta</th><th class="px-3 py-2 text-right font-medium">Valor</th></tr></thead>
              <tbody class="divide-y divide-slate-100 text-slate-700">
                <% [ [ "19/11", "Pix", "Banco", 3_480.00, :in ], [ "19/11", "Hortifruti", "Caixa Dinheiro", 612.40, :out ], [ "18/11", "Cartão de Crédito Visa", "Banco", 5_215.90, :in ], [ "18/11", "Salários", "Banco", 18_400.00, :out ], [ "17/11", "Transferência", "Caixa → Banco", 2_000.00, :transfer ], [ "17/11", "Cervejas", "Banco", 1_930.75, :out ] ].each do |date, desc, account, value, kind| %>
                  <tr>
                    <td class="px-3 py-2 text-slate-500"><%= date %></td>
                    <td class="px-3 py-2"><%= desc %></td>
                    <td class="hidden px-3 py-2 text-slate-500 sm:table-cell"><%= account %></td>
                    <td class="whitespace-nowrap px-3 py-2 text-right font-medium" style="color: <%= kind == :in ? income : kind == :out ? expense : "#64748b" %>"><%= kind == :in ? "+" : kind == :out ? "−" : "" %><%= brl(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>

    <%# 2. Para onde vai o dinheiro %>
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="lg:order-last">
        <h3 class="text-2xl font-bold tracking-tight">Para onde vai cada real</h3>
        <p class="mt-4 text-slate-600">Descubra em um olhar qual custo está comendo a sua margem. Quem mede o CMV todo mês, compra melhor no mês seguinte.</p>
        <div class="mt-6"><%= render "home/landing/check_list", items: [ "Ranking de despesas e entradas por categoria", "Comparativo automático com o mês anterior", "Histórico dos últimos 6 meses em gráfico" ] %></div>
      </div>
      <%= render layout: "home/landing/browser_frame", locals: { url: "/?month=2026-11" } do %>
        <div class="space-y-3 p-4 sm:p-5">
          <div class="grid grid-cols-2 gap-3">
            <%= render "home/stat_tile", label: "Gasto no mês", value: 103_874.15, change: -3.8, swatch: expense %>
            <%= render "home/stat_tile", label: "Resultado do mês", value: 44_446.75, change: 21.6 %>
          </div>
          <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-sm font-semibold text-slate-800">Despesas por categoria</p>
            <ul class="mt-3 space-y-3 text-xs">
              <% [ [ "Despesas fixas - CMO", 37, 100 ], [ "Despesas Variáveis - CMV", 28, 76 ], [ "Custo com Ocupação", 14, 38 ], [ "CMV - Bebidas", 10, 27 ], [ "Contas Publicas", 6, 16 ] ].each do |name, share, pct| %>
                <li class="grid grid-cols-[1fr_auto] items-center gap-x-3 gap-y-1">
                  <span class="truncate text-slate-600"><%= name %></span><span class="font-medium text-slate-800"><%= share %>%</span>
                  <div class="col-span-2 h-2 rounded-full bg-slate-100"><div class="h-2 rounded-full" style="width: <%= pct %>%; background: <%= expense %>"></div></div>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>

    <%# 3. Equipe %>
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h3 class="text-2xl font-bold tracking-tight">Sua equipe, suas regras</h3>
        <p class="mt-4 text-slate-600">Delegue os lançamentos do dia a dia sem abrir mão do controle. Cada pessoa vê apenas o que precisa.</p>
        <div class="mt-6"><%= render "home/landing/check_list", items: [ "Perfis prontos de dono e administrativo", "Crie perfis sob medida para gerente, caixa ou contador", "Adicione e remova pessoas quando quiser" ] %></div>
      </div>
      <%= render layout: "home/landing/browser_frame", locals: { url: "/team_members" } do %>
        <div class="p-4 sm:p-5">
          <div class="flex items-center justify-between">
            <p class="font-semibold text-slate-900">Equipe</p>
            <span class="rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-semibold text-white">+ Adicionar</span>
          </div>
          <ul class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
            <% [ [ "Ana Ribeiro", "ana@cantinadaana.com.br", "Dono", "bg-indigo-50 text-indigo-700 ring-indigo-200" ], [ "Carlos Mendes", "carlos@cantinadaana.com.br", "Administrativo", "bg-slate-50 text-slate-700 ring-slate-200" ], [ "Juliana Costa", "juliana@cantinadaana.com.br", "Gerente", "bg-emerald-50 text-emerald-700 ring-emerald-200" ], [ "Rafael Lima", "rafael@cantinadaana.com.br", "Caixa", "bg-amber-50 text-amber-700 ring-amber-200" ] ].each do |name, email, role, badge| %>
              <li class="flex items-center gap-3 px-3 py-2.5">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold text-slate-600"><%= name.split.map(&:first).join %></span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium text-slate-800"><%= name %></p>
                  <p class="truncate text-xs text-slate-500"><%= email %></p>
                </div>
                <span class="rounded-full px-2 py-0.5 text-xs font-medium ring-1 <%= badge %>"><%= role %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
