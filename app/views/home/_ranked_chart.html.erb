<%# Barras horizontais ordenadas (maior primeiro), uma única cor.
    locals: title:, subtitle:, rows: [[nome, valor], ...], color:, empty: %>
<section class="flex flex-col rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
  <h2 class="text-base font-semibold text-slate-800"><%= title %></h2>
  <p class="text-xs text-slate-500"><%= subtitle %></p>

  <% if rows.any? %>
    <% chart_data = { labels: rows.map(&:first), datasets: [ { label: title, data: rows.map { |_n, v| v.to_f }, backgroundColor: color } ] } %>
    <div class="relative mt-4 w-full" style="height: <%= [rows.size * 36 + 40, 160].max %>px">
      <%= tag.canvas role: "img", aria: { label: "#{title}: " + rows.map { |n, v| "#{n} #{brl(v)}" }.join(", ") },
            data: { controller: "money-chart", money_chart_type_value: "bar",
                    money_chart_data_value: chart_data.to_json,
                    money_chart_options_value: { indexAxis: "y" }.to_json } %>
    </div>
    <details class="mt-3 text-sm">
      <summary class="cursor-pointer text-xs font-semibold text-indigo-600 hover:text-indigo-500">Ver dados</summary>
      <table class="mt-2 w-full text-left">
        <tbody class="divide-y divide-slate-100">
          <% total = rows.sum { |_n, v| v } %>
          <% rows.each do |name, value| %>
            <tr>
              <td class="py-1.5 pr-2 text-slate-700"><%= name %></td>
              <td class="py-1.5 pr-2 text-right whitespace-nowrap text-slate-500"><%= total.positive? ? number_to_percentage(value / total * 100, precision: 0) : "—" %></td>
              <td class="py-1.5 text-right whitespace-nowrap font-medium text-slate-900"><%= brl(value) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </details>
  <% else %>
    <p class="flex flex-1 items-center justify-center py-10 text-center text-sm text-slate-500"><%= empty %></p>
  <% end %>
</section>
