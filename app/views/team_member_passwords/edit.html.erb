<% input_class = "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
<% label_class = "block text-sm/6 font-medium text-gray-900" %>
<% content_for :title, "Trocar senha · Zen Gastronomy" %>

<%= render "partials/page_header", title: "Trocar senha", subtitle: "A pessoa vai precisar entrar novamente com a nova senha." %>

<main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
  <div class="max-w-xl rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="mb-6 flex items-center gap-x-3">
      <%= user_avatar_tag(@member, "size-10 shrink-0") %>
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold text-gray-900"><%= @member.username %></p>
        <p class="truncate text-sm text-gray-500"><%= @member.email %> · <%= @member.role&.name %></p>
      </div>
    </div>

    <%= form_with model: @member, url: team_member_password_path(@member), method: :patch, scope: :user, class: "space-y-6" do |f| %>
      <%= render "partials/form_errors", record: @member %>

      <div>
        <%= f.label :password, "Nova senha", class: label_class %>
        <div class="mt-2"><%= f.password_field :password, required: true, autofocus: true, autocomplete: "new-password", class: input_class %></div>
        <p class="mt-1 text-xs text-gray-500">Mínimo de <%= User.password_length.min %> caracteres</p>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirmar nova senha", class: label_class %>
        <div class="mt-2"><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: input_class %></div>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to "Cancelar", team_members_path, class: "rounded-md bg-white px-3 py-2 text-center text-sm font-semibold text-gray-900 outline-1 outline-gray-300 hover:bg-gray-50" %>
        <%= f.submit "Salvar nova senha", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>
</main>
