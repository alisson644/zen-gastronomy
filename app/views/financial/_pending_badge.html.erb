<%# Conta a pagar (ex.: boleto de entrada de estoque): ainda não afeta o saldo. %>
<% if movement.pendente? %>
  <span class="mt-1 flex flex-wrap items-center gap-2">
    <span class="rounded bg-amber-50 px-1.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-amber-600/20 ring-inset">Pendente</span>
    <% if current_user.can?("movements.create") %>
      <%= button_to "Marcar como pago", pay_movement_path(movement), method: :patch, form_class: "inline",
            data: { turbo_confirm: "Confirmar o pagamento de #{brl(movement.amount)}? O valor será debitado de #{movement.account.name}." },
            class: "text-xs font-semibold text-indigo-600 hover:text-indigo-500" %>
    <% end %>
  </span>
<% end %>
