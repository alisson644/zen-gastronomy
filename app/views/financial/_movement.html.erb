<% type_labels = { "entrada" => "Entrada", "saida" => "Saída", "transfer" => "Transferência" } %>
<tr id="<%= dom_id movement %>" class="hover:bg-slate-50">
  <td class="px-4 py-3 border-b border-slate-200 text-sm text-slate-800">
    <%= movement.account.name %>
    <% if movement.transfer? && movement.related_account %>
      → <%= movement.related_account.name %>
    <% end %>
  </td>
  <td class="px-4 py-3 border-b border-slate-200 text-sm text-slate-800">
    <span class="block"><%= movement.subcategory&.name %></span>
    <span class="block text-xs text-slate-500"><%= movement.category&.name %></span>
  </td>
  <td class="px-4 py-3 border-b border-slate-200 text-sm text-slate-800"><%= type_labels[movement.mv_type] %></td>
  <td class="px-4 py-3 border-b border-slate-200 text-sm whitespace-nowrap <%= movement.saida? ? 'text-red-600' : movement.entrada? ? 'text-green-600' : 'text-slate-800' %>">
    <%= movement.saida? ? "-" : "" %><%= number_to_currency(movement.amount, precision: 2, unit: "R$", separator: ",", delimiter: ".") %>
  </td>
  <td class="px-4 py-3 border-b border-slate-200 text-sm whitespace-nowrap text-slate-800"><%= movement.occurred_at.strftime("%d/%m/%Y") %></td>
  <td class="hidden px-4 py-3 border-b border-slate-200 text-sm text-slate-800 lg:table-cell xl:max-w-xs xl:truncate"><%= movement.description %></td>
</tr>
