<header class="relative bg-white shadow-sm">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <ul class="flex flex-col gap-2 mt-2 mb-4 lg:mb-0 lg:mt-0 lg:flex-row lg:items-center lg:gap-6">
      <li class="flex items-center p-1 text-sm gap-x-2 text-slate-600">
        <button command="show-modal" commandfor="account" class="flex items-center">Nova Conta</button>
      </li>
      <li class="flex items-center p-1 text-sm gap-x-2 text-slate-600">
        <button command="show-modal" commandfor="transaction"  class="flex items-center">Nova transação</button>
      </li>
    </ul>
  </div>
</header>
<main>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="relative flex flex-col my-6 bg-white shadow-sm border border-slate-200 rounded-lg w-96">
  <div class="p-4">
    <h6 class="mb-2 text-slate-800 text-xl font-semibold">
      Saldo Total: <%=number_to_currency @company.accounts.sum(&:current_balance), precision: 2, unit: "R$", separator: ",", delimiter: "." %>
    </h6>
    <canvas
      data-controller="chartjs"
      data-chartjs-type-value = "bar"
      data-chartjs-data-value='{ "labels": <%= @accounts_name.map(&:name) %>, "datasets": [{ "label": "Contas", "backgroundColor": ["Red", "Orange", "Yellow", "Green", "Blue"] , "borderColor": "#3B82F6", "data": <%= @accounts_name.map(&:current_balance) %> }] }'
    ></canvas>
  </div>
</div> 



