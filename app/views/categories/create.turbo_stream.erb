<% categories = @company.categories.includes(:subcategories).order(:id) %>
<% modal_categories = expense_only? ? categories.where(is_income: false) : categories %>
<% if expense_only? %>
  <% if @subcategory %>
    <%= render "partials/stock_subcategory_streams", selected: @subcategory.id %>
  <% end %>
<% else %>
  <%= turbo_stream.replace "subcategory_select", partial: "partials/subcategory_select", locals: { categories: categories, selected: @subcategory&.id } %>
<% end %>
<%= turbo_stream.replace "category_form", partial: "partials/category_form", locals: { category: Category.new, expense_only: expense_only? } %>
<%# Já deixa a nova categoria escolhida no modal de subcategoria, caso o usuário queira adicionar uma em seguida %>
<%= turbo_stream.replace "subcategory_form", partial: "partials/subcategory_form", locals: { subcategory: Subcategory.new(category: @category), categories: modal_categories, expense_only: expense_only? } %>
