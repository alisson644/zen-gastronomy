<% input_class = "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
<% label_class = "block text-sm/6 font-medium text-gray-900" %>
<% content_for :title, "Entrar · Zen Gastronomy" %>
<% content_for :auth_footer do %>
  Ainda não tem conta?
  <%= link_to "Criar conta", new_registration_path(resource_name), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
<% end %>

<%= render layout: "devise/shared/auth_card", locals: { title: "Entrar na sua conta", subtitle: "Bem-vindo de volta" } do %>
  <% if alert.present? %>
    <div class="mb-6 rounded-md bg-red-50 p-3 text-sm text-red-700"><%= alert %></div>
  <% end %>
  <% if notice.present? %>
    <div class="mb-6 rounded-md bg-green-50 p-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    <div>
      <%= f.label :email, "E-mail", class: label_class %>
      <div class="mt-2">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: input_class %>
      </div>
    </div>

    <div>
      <div class="flex items-center justify-between">
        <%= f.label :password, "Senha", class: label_class %>
        <% if devise_mapping.recoverable? %>
          <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
        <% end %>
      </div>
      <div class="mt-2">
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: input_class %>
      </div>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-x-3">
        <div class="group relative inline-flex w-8 shrink-0 rounded-full bg-gray-200 p-px inset-ring inset-ring-gray-900/5 outline-offset-2 outline-indigo-600 transition-colors duration-200 ease-in-out has-checked:bg-indigo-600 has-focus-visible:outline-2">
          <span class="size-4 rounded-full bg-white shadow-xs ring-1 ring-gray-900/5 transition-transform duration-200 ease-in-out group-has-checked:translate-x-3.5"></span>
          <%= f.check_box :remember_me, class: "absolute inset-0 appearance-none focus:outline-hidden" %>
        </div>
        <%= f.label :remember_me, "Lembrar de mim", class: "text-sm/6 text-gray-600" %>
      </div>
    <% end %>

    <%= f.submit "Entrar", class: "w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
  <% end %>
<% end %>
