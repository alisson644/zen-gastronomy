<% input_class = "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
<% label_class = "block text-sm/6 font-medium text-gray-900" %>
<% card_class = "rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6" %>
<% content_for :title, "Perfil · Zen Gastronomy" %>

<header class="relative bg-white shadow-sm">
  <div class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-6 sm:px-6 lg:px-8">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Perfil</h1>
    <p class="text-sm text-gray-500">Gerencie seus dados de acesso</p>
  </div>
</header>

<main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
  <% if notice.present? %>
    <div class="rounded-md bg-green-50 p-3 text-sm text-green-700"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="rounded-md bg-red-50 p-3 text-sm text-red-700"><%= alert %></div>
  <% end %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <section class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
      <div>
        <h2 class="text-base/7 font-semibold text-gray-900">Dados pessoais</h2>
        <p class="mt-1 text-sm text-gray-500">Nome exibido no sistema e e-mail usado para entrar.</p>
      </div>
      <div class="<%= card_class %> space-y-6 md:col-span-2">
        <div data-controller="avatar-upload">
          <span class="<%= label_class %>">Foto</span>
          <div class="mt-2 flex items-center gap-x-4">
            <%= user_avatar_tag(resource, "size-16 shrink-0 outline -outline-offset-1 outline-gray-900/10", data: { avatar_upload_target: "preview" }) %>
            <div class="min-w-0 space-y-2">
              <%= f.file_field :avatar, accept: User::AVATAR_CONTENT_TYPES.join(","),
                    data: { action: "change->avatar-upload#preview" },
                    class: "block w-full text-sm text-gray-500 file:mr-3 file:rounded-md file:border-0 file:bg-white file:px-3 file:py-2 file:text-sm file:font-semibold file:text-gray-900 file:outline-1 file:outline-gray-300 hover:file:bg-gray-50" %>
              <p class="text-xs text-gray-500">PNG, JPG ou WEBP até 2 MB. Opcional.</p>
              <%# Envia o mesmo form para /avatar: salva só a foto, sem pedir a senha atual %>
              <button type="submit" formaction="<%= avatar_path %>" formnovalidate hidden
                      data-avatar-upload-target="save"
                      class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">Salvar foto</button>
              <% if resource.avatar.attached? && resource.avatar.persisted? %>
                <div class="flex items-center gap-x-2">
                  <%= f.check_box :remove_avatar, class: "size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
                  <%= f.label :remove_avatar, "Remover foto", class: "text-sm text-gray-700" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <div>
          <%= f.label :username, "Nome de usuário", class: label_class %>
          <div class="mt-2">
            <%= f.text_field :username, autocomplete: "username", required: true, class: input_class %>
          </div>
        </div>
        <div>
          <%= f.label :email, "E-mail", class: label_class %>
          <div class="mt-2">
            <%= f.email_field :email, autocomplete: "email", required: true, class: input_class %>
          </div>
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="mt-1 text-xs text-amber-600">Aguardando confirmação de: <%= resource.unconfirmed_email %></p>
          <% end %>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
      <div>
        <h2 class="text-base/7 font-semibold text-gray-900">Alterar senha</h2>
        <p class="mt-1 text-sm text-gray-500">Deixe em branco para manter a senha atual.</p>
      </div>
      <div class="<%= card_class %> space-y-6 md:col-span-2">
        <div>
          <%= f.label :password, "Nova senha", class: label_class %>
          <div class="mt-2">
            <%= f.password_field :password, autocomplete: "new-password", class: input_class %>
          </div>
          <% if @minimum_password_length %>
            <p class="mt-1 text-xs text-gray-500">Mínimo de <%= @minimum_password_length %> caracteres</p>
          <% end %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmar nova senha", class: label_class %>
          <div class="mt-2">
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input_class %>
          </div>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
      <div>
        <h2 class="text-base/7 font-semibold text-gray-900">Confirmação</h2>
        <p class="mt-1 text-sm text-gray-500">Informe sua senha atual para salvar as alterações.</p>
      </div>
      <div class="<%= card_class %> space-y-6 md:col-span-2">
        <div>
          <%= f.label :current_password, "Senha atual", class: label_class %>
          <div class="mt-2">
            <%= f.password_field :current_password, autocomplete: "current-password", required: true, class: input_class %>
          </div>
        </div>
        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <%= link_to "Cancelar", root_path, class: "rounded-md bg-white px-3 py-2 text-center text-sm font-semibold text-gray-900 outline-1 outline-gray-300 hover:bg-gray-50" %>
          <%= f.submit "Salvar alterações", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
        </div>
      </div>
    </section>
  <% end %>

  <section class="grid grid-cols-1 gap-4 border-t border-slate-200 pt-6 md:grid-cols-3 md:gap-6">
    <div>
      <h2 class="text-base/7 font-semibold text-red-700">Zona de perigo</h2>
      <p class="mt-1 text-sm text-gray-500">Ações irreversíveis sobre a sua conta.</p>
    </div>
    <div class="flex flex-col gap-4 rounded-lg border border-red-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-6 md:col-span-2">
      <div>
        <p class="text-sm font-semibold text-gray-900">Excluir minha conta</p>
        <p class="mt-1 text-sm text-gray-500">Seu usuário será removido permanentemente.</p>
      </div>
      <%= button_to "Excluir conta", registration_path(resource_name), method: :delete,
            data: { turbo_confirm: "Tem certeza? Esta ação não pode ser desfeita." },
            class: "w-full shrink-0 rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500 sm:w-auto" %>
    </div>
  </section>
</main>
