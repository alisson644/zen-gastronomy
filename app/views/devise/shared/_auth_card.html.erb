<div class="flex min-h-screen flex-col justify-center bg-gray-50 px-4 py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <%= link_to root_path, class: "flex justify-center" do %>
      <span class="sr-only">Zen Gastronomy</span>
      <%= image_tag("logo02.png", alt: "Zen Gastronomy", class: "h-12 w-auto") %>
    <% end %>
    <h1 class="mt-6 text-center text-2xl font-bold tracking-tight text-gray-900"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-2 text-center text-sm text-gray-500"><%= subtitle %></p>
    <% end %>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="rounded-lg border border-slate-200 bg-white px-4 py-6 shadow-sm sm:p-8">
      <%= yield %>
    </div>
    <% if content_for?(:auth_footer) %>
      <p class="mt-6 text-center text-sm text-gray-500"><%= yield :auth_footer %></p>
    <% end %>
  </div>
</div>
