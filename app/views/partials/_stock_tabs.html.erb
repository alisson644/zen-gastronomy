<%# Navegação entre as telas do estoque; mostra só o que o perfil permite. %>
<%
  tabs = [
    ["Visão geral", stock_path, "stock.view"],
    ["Produtos", products_path, "products.manage"],
    ["Fornecedores", suppliers_path, "suppliers.manage"],
    ["Entradas", stock_entries_path, "stock.entries"],
    ["Conferências", stock_counts_path, "stock.count"]
  ].select { |_label, _path, permission| current_user.can?(permission) }
%>
<% if tabs.size > 1 %>
  <nav class="border-b border-slate-200 bg-white" aria-label="Estoque">
    <div class="mx-auto flex max-w-7xl gap-x-6 overflow-x-auto px-4 sm:px-6 lg:px-8">
      <% tabs.each do |label, path, _permission| %>
        <% active = request.path == path || (path != stock_path && request.path.start_with?("#{path}/")) %>
        <%= link_to label, path, aria: { current: (active ? "page" : nil) },
              class: "shrink-0 border-b-2 py-3 text-sm font-medium #{active ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}" %>
      <% end %>
    </div>
  </nav>
<% end %>
