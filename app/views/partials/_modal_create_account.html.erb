<el-dialog>
    <dialog id="account" aria-labelledby="dialog-title" class=" inset-0 size-auto max-h-none max-w-none overflow-y-auto overflow-x-auto bg-transparent backdrop:bg-transparent">
        <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>

        <div tabindex="0" class="flex min-h-auto justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
            <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg data-closed:sm:translate-y-0 data-closed:sm:scale-95">
                <div class="bg-white pt-5 pb-4 p-6">
                    <div class="grid">
                        <div class="mt-3 text-center">
                        <div class="mt-2">
                            <%= form_with model: account do |form| %>
                                <div class="space-y-12 text-center">
                                    <div class="border-gray-900/10 ">
                                    <h2 class="text-base/7 font-semibold text-gray-900">CONTA</h2>

                                    <div class="grid auto-cols-1 gap-y-8 mt-3">
                                        <div class="col-span-full">
                                        <label for="name" class="block text-sm/6 font-medium text-gray-900">Nome da conta</label>
                                        <div class="mt-2">
                                            <div class="rounded-md bg-white pl-3 outline-1 -outline-offset-1 outline-gray-300 focus-within:outline-2 focus-within:-outline-offset-2 focus-within:outline-indigo-600">
                                            <%= form.text_field :name, placeholder: "Nome da conta", class: "block min-w-0 grow bg-white py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6" %>
                                            </div>
                                        </div>
                                        </div>

                                        <div class="col-span-full">
                                        <label for="address" class="block text-sm/6 font-medium text-gray-900">Tipo da conta</label>
                                        <div class="mt-2">
                                          <%= form.select :account_type, options_for_select([['Banco', 'banco'], ['Caixa', 'caixa'], ['Investimento', 'investimento'], ['Cartão', 'cartao'], ['Outros', 'outros']]), { prompt: "Selecione o tipo da conta" }, class: "block min-w-0 grow py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6" %>
                                        </div>
                                        </div>

                                        <div class="col-span-full">
                                        <label for="initial_balance" class="block text-sm/6 font-medium text-gray-900">Saldo Inicial</label>
                                        <div class="mt-2">
                                            <div class="flex items-center rounded-md bg-white pl-3 outline-1 -outline-offset-1 outline-gray-300 has-[input:focus-within]:outline-2 has-[input:focus-within]:-outline-offset-2 has-[input:focus-within]:outline-indigo-600">
                                            <div class="shrink-0 text-base text-gray-500 select-none sm:text-sm/6">R$</div>
                                            <%= form.number_field :initial_balance, inputmode: "numeric", placeholder: "0.00", class: "block min-w-0 grow py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6" %>
                                            </div>
                                        </div>
                                        </div>

                                        <div class="col-span-full">
                                        <label for="current_balance" class="block text-sm/6 font-medium text-gray-900">Saldo Atual</label>
                                        <div class="mt-2">
                                            <div class="flex items-center rounded-md bg-white pl-3 outline-1 -outline-offset-1 outline-gray-300 has-[input:focus-within]:outline-2 has-[input:focus-within]:-outline-offset-2 has-[input:focus-within]:outline-indigo-600">
                                            <div class="shrink-0 text-base text-gray-500 select-none sm:text-sm/6">R$</div>
                                            <%= form.number_field :current_balance, inputmode: "numeric", placeholder: "0.00", class: "block min-w-0 grow py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6" %>
                                            </div>
                                        </div>
                                        </div>
                                        
                    
                                        <div class="col-span-full">
                                            <%= form.submit 'salvar', command: "close", commandfor: "account", class:"justify-center w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-indigo-500" %>
                                        </div>
                                    </div>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                        </div>
                    </div>
                </div>
            </el-dialog-panel>
        </div>
    </dialog>
</el-dialog>
