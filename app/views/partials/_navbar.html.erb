<% if user_signed_in? %>
  <%
    # [rótulo, caminho, ícone, permissão, precisa de empresa?]
    nav_items = [
      ["Dashboard",  root_path,             "M2.25 12l8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25", "dashboard.view", true],
      ["Financeiro", financial_index_path,  "M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z", "financial.view", true],
      ["Equipe",     team_members_path,     "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z", "team.manage", true],
      ["Empresas",   admin_companies_path,  "M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21", "companies.view_all", false],
      ["Perfis",     roles_path,            "M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z", "roles.manage", true]
    ].select do |_label, _path, _icon, permission, needs_company|
      current_user.can?(permission) && (!needs_company || current_company.present? || !current_user.system_admin?)
    end
  %>

  <%# Barra superior (somente mobile) %>
  <div class="sticky top-0 z-30 flex h-16 items-center gap-x-4 bg-gray-800 px-4 md:hidden">
    <button type="button" data-action="sidebar#open" class="-m-2.5 rounded-md p-2.5 text-gray-400 hover:bg-white/5 hover:text-white">
      <span class="sr-only">Abrir menu</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6">
        <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <%= image_tag("logo02.png", alt: "Zen Gastronomy", class: "h-8 w-auto") %>
  </div>

  <%# Fundo escuro quando a gaveta está aberta no mobile %>
  <div data-action="click->sidebar#close" class="fixed inset-0 z-40 hidden bg-gray-900/60 group-data-open/layout:block md:hidden!"></div>

  <%# Sidebar %>
  <nav class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col bg-gray-800 group-data-open/layout:translate-x-0 md:translate-x-0 md:group-data-collapsed/layout:w-20 group-data-animate/layout:transition-all duration-200">
    <%# Logo + toggle %>
    <div class="flex h-16 shrink-0 items-center justify-between gap-2 px-4 md:group-data-collapsed/layout:justify-center">
      <div class="md:group-data-collapsed/layout:hidden">
        <%= image_tag("logo02.png", alt: "Zen Gastronomy", class: "h-10 w-auto") %>
      </div>

      <%# Recolher/expandir (desktop) %>
      <button type="button" data-action="sidebar#toggle" class="hidden rounded-md p-2 text-gray-400 hover:bg-white/5 hover:text-white md:block" title="Recolher/expandir menu">
        <span class="sr-only">Recolher/expandir menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6 group-data-collapsed/layout:rotate-180 transition-transform">
          <path d="m18.75 4.5-7.5 7.5 7.5 7.5m-6-15L5.25 12l7.5 7.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <%# Fechar (mobile) %>
      <button type="button" data-action="sidebar#close" class="rounded-md p-2 text-gray-400 hover:bg-white/5 hover:text-white md:hidden">
        <span class="sr-only">Fechar menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6">
          <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <%# Links %>
    <ul class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
      <% nav_items.each do |label, path, icon, _permission, _needs_company| %>
        <% active = current_page?(path) %>
        <li>
          <%= link_to path, title: label, aria: { current: (active ? "page" : nil) },
                class: "flex items-center gap-x-3 rounded-md px-3 py-2 text-sm font-medium md:group-data-collapsed/layout:justify-center #{active ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-white/5 hover:text-white'}" do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6 shrink-0">
              <path d="<%= icon %>" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="truncate md:group-data-collapsed/layout:sr-only"><%= label %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <%# Usuário %>
    <div class="border-t border-white/10 p-3">
      <el-dropdown class="relative block">
        <button class="flex w-full items-center gap-x-3 rounded-md p-2 text-left hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-indigo-500 md:group-data-collapsed/layout:justify-center">
          <span class="sr-only">Abrir menu do usuário</span>
          <%= user_avatar_tag(current_user, "size-8 shrink-0 outline -outline-offset-1 outline-white/10") %>
          <span class="min-w-0 md:group-data-collapsed/layout:hidden">
            <span class="block truncate text-sm font-medium text-white"><%= current_user.username %></span>
            <span class="block truncate text-xs text-gray-400"><%= current_user.email %></span>
          </span>
        </button>

        <el-menu anchor="top start" popover class="w-48 origin-bottom-left rounded-md bg-white py-1 shadow-lg outline-1 outline-black/5 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
          <%= link_to "Perfil", edit_user_registration_path, class: "block px-4 py-2 text-sm text-gray-700 focus:bg-gray-100 focus:outline-hidden", data: { turbo_method: :get } %>
          <%= link_to "Sair", destroy_user_session_path, class: "block px-4 py-2 text-sm text-gray-700 focus:bg-gray-100 focus:outline-hidden", data: { turbo_method: :delete } %>
        </el-menu>
      </el-dropdown>
    </div>
  </nav>
<% end %>
