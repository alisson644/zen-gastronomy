<% input_class = "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
<% label_class = "block text-sm/6 font-medium text-gray-900" %>
<div id="transaction_form">
  <%= form_with model: movement, data: { controller: "modal-form transaction-type", action: "turbo:submit-end->modal-form#close reset->transaction-type#reset" } do |form| %>
    <h2 class="text-base/7 font-semibold text-gray-900">TRANSAÇÃO</h2>
    <%= render "partials/form_errors", record: movement %>

    <div class="grid gap-y-6 mt-3 text-left">
      <div>
        <%= form.label :mv_type, "Tipo de transação", class: label_class %>
        <div class="mt-2">
          <%= form.select :mv_type, [["Entrada", "entrada"], ["Saída", "saida"], ["Transferência", "transfer"]], { prompt: "Selecione o tipo de transação" }, required: true, class: input_class,
                data: { transaction_type_target: "type", action: "change->transaction-type#update" } %>
        </div>
      </div>

      <div>
        <%= form.label :account_id, "Conta", class: label_class %>
        <div class="mt-2">
          <%= form.collection_select :account_id, accounts, :id, :name, { prompt: "Selecione a conta" }, required: true, class: input_class %>
        </div>
      </div>

      <div data-transaction-type-target="relatedAccount" hidden>
        <%= form.label :related_account_id, "Conta destino", class: label_class %>
        <div class="mt-2">
          <%= form.collection_select :related_account_id, accounts, :id, :name, { prompt: "Selecione a conta destino" }, class: input_class,
                data: { transaction_type_target: "relatedAccountSelect" } %>
        </div>
      </div>

      <div data-transaction-type-target="category">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
          <%= form.label :subcategory_id, "Categoria", class: label_class %>
          <div class="flex gap-3 text-xs font-semibold text-indigo-600">
            <% if current_user.can?("categories.manage") %>
              <button type="button" command="show-modal" commandfor="category" class="hover:text-indigo-500">+ Categoria</button>
              <button type="button" command="show-modal" commandfor="subcategory" class="hover:text-indigo-500">+ Subcategoria</button>
            <% end %>
          </div>
        </div>
        <div class="mt-2">
          <%= render "partials/subcategory_select", categories: categories, selected: movement.subcategory_id %>
        </div>
      </div>

      <div>
        <%= form.label :amount, "Valor", class: label_class %>
        <div class="mt-2">
          <div class="flex items-center rounded-md bg-white pl-3 outline-1 -outline-offset-1 outline-gray-300 has-[input:focus-within]:outline-2 has-[input:focus-within]:-outline-offset-2 has-[input:focus-within]:outline-indigo-600">
            <div class="shrink-0 text-base text-gray-500 select-none sm:text-sm/6">R$</div>
            <%= form.text_field :amount, value: (movement.amount.present? ? number_with_precision(movement.amount, precision: 2, separator: ",", delimiter: ".") : nil), inputmode: "decimal", autocomplete: "off", placeholder: "0,00", required: true, data: { controller: "currency-input", action: "input->currency-input#input blur->currency-input#blur" }, class: "block min-w-0 grow py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6" %>
          </div>
        </div>
      </div>

      <div>
        <%= form.label :occurred_at, "Data da movimentação", class: label_class %>
        <div class="mt-2">
          <%= form.date_field :occurred_at, value: (movement.occurred_at || Date.current).to_date, required: true, class: input_class %>
        </div>
      </div>

      <div>
        <%= form.label :description, "Descrição", class: label_class %>
        <div class="mt-2">
          <%= form.textarea :description, rows: 3, class: input_class %>
        </div>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row">
        <button type="button" command="close" commandfor="transaction" class="w-full rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 outline-1 outline-gray-300 hover:bg-gray-50">Cancelar</button>
        <%= form.submit "Salvar", class: "w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      </div>
    </div>
  <% end %>
</div>
