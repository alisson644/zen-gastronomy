<% products = current_company.products.active.ordered %>
<div class="max-w-4xl rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
  <%= form_with model: entry, class: "space-y-8", data: { controller: "stock-entry nested-fields" } do |f| %>
    <%= render "partials/form_errors", record: entry %>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-6">
      <div class="sm:col-span-3">
        <%= f.label :supplier_id, "Fornecedor", class: stock_label_class %>
        <div class="mt-2"><%= f.collection_select :supplier_id, current_company.suppliers.active.ordered, :id, :name, { prompt: "Selecione o fornecedor" }, required: true, class: stock_input_class %></div>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :invoice_number, "Nota fiscal", class: stock_label_class %>
        <div class="mt-2"><%= f.text_field :invoice_number, class: stock_input_class %></div>
      </div>
      <div class="sm:col-span-1">
        <%= f.label :received_on, "Recebido em", class: stock_label_class %>
        <div class="mt-2"><%= f.date_field :received_on, required: true, class: stock_input_class %></div>
      </div>
    </div>

    <fieldset>
      <legend class="text-sm/6 font-semibold text-gray-900">Produtos</legend>
      <div class="mt-3 space-y-3" data-nested-fields-target="container">
        <%= f.fields_for :items do |item_f| %>
          <%= render "stock_entries/item_fields", f: item_f, products: products %>
        <% end %>
      </div>
      <template data-nested-fields-target="template">
        <%= f.fields_for :items, StockEntryItem.new, child_index: "NEW_RECORD" do |item_f| %>
          <%= render "stock_entries/item_fields", f: item_f, products: products %>
        <% end %>
      </template>
      <div class="mt-3 flex items-center justify-between">
        <button type="button" data-action="nested-fields#add" class="text-sm font-semibold text-indigo-600 hover:text-indigo-500">+ Adicionar produto</button>
        <p class="text-sm text-slate-700">Total: <strong data-stock-entry-target="total"><%= brl(entry.total) %></strong></p>
      </div>
      <% if products.empty? && current_user.can?("products.manage") %>
        <p class="mt-2 text-sm text-gray-500">Nenhum produto ativo. <%= link_to "Cadastrar produto", new_product_path, class: "font-semibold text-indigo-600" %></p>
      <% end %>
    </fieldset>

    <fieldset class="grid grid-cols-1 gap-6 border-t border-slate-200 pt-6 sm:grid-cols-6">
      <legend class="sr-only">Pagamento</legend>
      <p class="text-sm/6 font-semibold text-gray-900 sm:col-span-6">Pagamento (lançado no financeiro como saída)</p>
      <div class="sm:col-span-2">
        <%= f.label :payment_method, "Forma de pagamento", class: stock_label_class %>
        <div class="mt-2">
          <%= f.select :payment_method, StockEntry::PAYMENT_METHODS.map { |key, label| [label, key] }, {}, required: true, class: stock_input_class,
                data: { stock_entry_target: "paymentMethod", action: "change->stock-entry#togglePayment" } %>
        </div>
      </div>
      <div class="sm:col-span-2" data-stock-entry-target="dueOn">
        <%= f.label :due_on, "Vencimento do boleto", class: stock_label_class %>
        <div class="mt-2"><%= f.date_field :due_on, class: stock_input_class, data: { stock_entry_target: "dueOnInput" } %></div>
        <p class="mt-1 text-xs text-amber-700">Fica pendente no financeiro até ser marcado como pago.</p>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :account_id, "Conta", class: stock_label_class %>
        <div class="mt-2"><%= f.collection_select :account_id, current_company.accounts.order(:name), :id, :name, { prompt: "Selecione a conta" }, required: true, class: stock_input_class %></div>
      </div>
      <div class="sm:col-span-3">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
          <%= f.label :subcategory_id, "Categoria no financeiro", class: stock_label_class %>
          <%= render "partials/category_buttons" %>
        </div>
        <div class="mt-2">
          <%= render "partials/expense_subcategory_select", field: :stock_entry, selected: entry.subcategory_id %>
        </div>
      </div>
      <div class="sm:col-span-6">
        <%= f.label :notes, "Observações", class: stock_label_class %>
        <div class="mt-2"><%= f.textarea :notes, rows: 2, class: stock_input_class %></div>
      </div>
    </fieldset>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <%= link_to "Cancelar", stock_entries_path, class: stock_secondary_button %>
      <%= f.submit "Registrar entrada", class: stock_primary_button %>
    </div>
  <% end %>
</div>
