<%# locals: entry %>
<% if entry.movement&.pendente? %>
  <span class="rounded bg-amber-50 px-1.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-amber-600/20 ring-inset">Pendente · vence <%= entry.due_on.strftime("%d/%m/%Y") %></span>
<% elsif entry.movement %>
  <span class="rounded bg-green-50 px-1.5 py-0.5 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Pago</span>
<% end %>
