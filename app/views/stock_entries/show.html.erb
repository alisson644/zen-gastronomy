<% content_for :title, "Entrada de estoque · Zen Gastronomy" %>

<%= render "partials/page_header", title: "Entrada de #{@entry.supplier.name}",
      subtitle: ["Recebida em #{@entry.received_on.strftime("%d/%m/%Y")}", ("NF #{@entry.invoice_number}" if @entry.invoice_number.present?), @entry.creator&.username].compact.join(" · ") %>
<%= render "partials/stock_tabs" %>

<div class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
  <section class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
    <table class="w-full table-auto text-left text-sm">
      <thead class="bg-slate-50 text-slate-500">
        <tr>
          <th class="px-4 py-3 font-normal">Produto</th>
          <th class="px-4 py-3 text-right font-normal">Quantidade</th>
          <th class="px-4 py-3 text-right font-normal">Custo unitário</th>
          <th class="px-4 py-3 text-right font-normal">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @entry.items.each do |item| %>
          <tr>
            <td class="px-4 py-3 text-slate-800"><%= item.product.name %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap text-slate-800"><%= qty(item.quantity) %> <%= item.product.unit %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap text-slate-600"><%= brl(item.unit_cost) %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap text-slate-800"><%= brl(item.total) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="border-t border-slate-200">
          <td colspan="3" class="px-4 py-3 text-right font-semibold text-slate-800">Total</td>
          <td class="px-4 py-3 text-right font-semibold whitespace-nowrap text-slate-900"><%= brl(@entry.total) %></td>
        </tr>
      </tfoot>
    </table>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <h2 class="text-base font-semibold text-slate-800">Financeiro</h2>
    <dl class="mt-3 grid grid-cols-1 gap-4 text-sm sm:grid-cols-4">
      <div><dt class="text-slate-500">Forma de pagamento</dt><dd class="mt-1 text-slate-800"><%= @entry.payment_method_label %></dd></div>
      <div><dt class="text-slate-500">Conta</dt><dd class="mt-1 text-slate-800"><%= @entry.account.name %></dd></div>
      <div><dt class="text-slate-500">Categoria</dt><dd class="mt-1 text-slate-800"><%= @entry.subcategory.name %></dd></div>
      <div><dt class="text-slate-500">Situação</dt><dd class="mt-1"><%= render "stock_entries/payment_badge", entry: @entry %></dd></div>
    </dl>
    <% if @entry.notes.present? %>
      <p class="mt-4 text-sm text-slate-600"><%= @entry.notes %></p>
    <% end %>
    <% if current_user.can?("financial.view") %>
      <%= link_to "Ver no financeiro", financial_index_path, class: "mt-4 inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
    <% end %>
  </section>
</div>
