<% suppliers = current_company.suppliers.ordered %>
<div class="max-w-3xl rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
  <%= form_with model: product, class: "space-y-6" do |f| %>
    <%= render "partials/form_errors", record: product %>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-6">
      <div class="sm:col-span-4">
        <%= f.label :name, "Nome", class: stock_label_class %>
        <div class="mt-2"><%= f.text_field :name, required: true, autofocus: true, class: stock_input_class %></div>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :code, "Código", class: stock_label_class %>
        <div class="mt-2"><%= f.text_field :code, class: stock_input_class %></div>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :unit, "Unidade", class: stock_label_class %>
        <div class="mt-2"><%= f.select :unit, Product::UNITS.map { |key, label| ["#{label} (#{key})", key] }, {}, class: stock_input_class %></div>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :min_quantity, "Estoque mínimo", class: stock_label_class %>
        <div class="mt-2"><%= f.text_field :min_quantity, value: decimal_field_value(product.min_quantity, precision: 3), inputmode: "decimal", autocomplete: "off", class: stock_input_class %></div>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :sale_price, "Preço de venda (R$)", class: stock_label_class %>
        <div class="mt-2">
          <%= f.text_field :sale_price, value: decimal_field_value(product.sale_price), inputmode: "decimal", autocomplete: "off", placeholder: "0,00",
                data: { controller: "currency-input", action: "input->currency-input#input blur->currency-input#blur" }, class: stock_input_class %>
        </div>
      </div>
      <div class="sm:col-span-4">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
          <%= f.label :subcategory_id, "Categoria no financeiro (para compras)", class: stock_label_class %>
          <%= render "partials/category_buttons" %>
        </div>
        <div class="mt-2">
          <%= render "partials/expense_subcategory_select", field: :product, selected: product.subcategory_id %>
        </div>
      </div>
      <label class="flex items-center gap-x-3 sm:col-span-2 sm:mt-8">
        <%= f.check_box :active, class: "size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
        <span class="text-sm text-gray-700">Ativo</span>
      </label>
    </div>

    <fieldset data-controller="nested-fields">
      <legend class="text-sm/6 font-medium text-gray-900">Fornecedores</legend>
      <p class="mt-1 text-xs text-gray-500">O último preço é atualizado automaticamente a cada entrada de estoque.</p>
      <% if suppliers.empty? %>
        <p class="mt-3 text-sm text-gray-500">
          Nenhum fornecedor cadastrado.
          <% if current_user.can?("suppliers.manage") %><%= link_to "Cadastrar fornecedor", new_supplier_path, class: "font-semibold text-indigo-600" %><% end %>
        </p>
      <% else %>
        <div class="mt-3 space-y-3" data-nested-fields-target="container">
          <%= f.fields_for :product_suppliers do |sf| %>
            <%= render "products/supplier_fields", f: sf, suppliers: suppliers %>
          <% end %>
        </div>
        <template data-nested-fields-target="template">
          <%= f.fields_for :product_suppliers, ProductSupplier.new, child_index: "NEW_RECORD" do |sf| %>
            <%= render "products/supplier_fields", f: sf, suppliers: suppliers %>
          <% end %>
        </template>
        <button type="button" data-action="nested-fields#add" class="mt-3 text-sm font-semibold text-indigo-600 hover:text-indigo-500">+ Adicionar fornecedor</button>
      <% end %>
    </fieldset>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <%= link_to "Cancelar", product.persisted? ? product_path(product) : products_path, class: stock_secondary_button %>
      <%= f.submit "Salvar produto", class: stock_primary_button %>
    </div>
  <% end %>
</div>
