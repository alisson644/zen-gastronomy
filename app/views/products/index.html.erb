<% content_for :title, "Produtos · Zen Gastronomy" %>

<%= render layout: "partials/page_header", locals: { title: "Produtos", subtitle: "Cadastro de produtos de #{current_company.name}" } do %>
  <%= link_to "Novo produto", new_product_path, class: stock_primary_button %>
<% end %>
<%= render "partials/stock_tabs" %>

<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
  <% if @products.any? %>
    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
      <table class="w-full table-auto text-left text-sm">
        <thead class="bg-slate-50 text-slate-500">
          <tr>
            <th class="px-4 py-3 font-normal">Produto</th>
            <th class="hidden px-4 py-3 font-normal md:table-cell">Fornecedores</th>
            <th class="px-4 py-3 text-right font-normal">Estoque</th>
            <th class="hidden px-4 py-3 text-right font-normal sm:table-cell">Custo médio</th>
            <th class="hidden px-4 py-3 text-right font-normal sm:table-cell">Preço de venda</th>
            <th class="px-4 py-3"><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @products.each do |product| %>
            <tr id="<%= dom_id(product) %>">
              <td class="px-4 py-3 text-slate-800">
                <%= link_to product.name, product_path(product), class: "font-medium hover:text-indigo-600" %>
                <% if product.code.present? %><span class="text-xs text-slate-500">· <%= product.code %></span><% end %>
                <% unless product.active? %><span class="ml-1 rounded bg-gray-100 px-1.5 py-0.5 text-xs font-medium text-gray-600">inativo</span><% end %>
              </td>
              <td class="hidden px-4 py-3 text-slate-600 md:table-cell"><%= product.suppliers.map(&:name).sort.join(", ").presence || "—" %></td>
              <td class="px-4 py-3 text-right whitespace-nowrap text-slate-800"><%= qty(product.quantity) %> <%= product.unit %></td>
              <td class="hidden px-4 py-3 text-right whitespace-nowrap text-slate-600 sm:table-cell"><%= brl(product.average_cost) %></td>
              <td class="hidden px-4 py-3 text-right whitespace-nowrap text-slate-600 sm:table-cell"><%= product.sale_price ? brl(product.sale_price) : "—" %></td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <%= link_to "Editar", edit_product_path(product), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "partials/empty_state", message: "Nenhum produto cadastrado." %>
  <% end %>
</div>
