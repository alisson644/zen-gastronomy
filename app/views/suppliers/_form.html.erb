<div class="max-w-2xl rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
  <%= form_with model: supplier, class: "space-y-6" do |f| %>
    <%= render "partials/form_errors", record: supplier %>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= f.label :name, "Nome", class: stock_label_class %>
        <div class="mt-2"><%= f.text_field :name, required: true, autofocus: true, class: stock_input_class %></div>
      </div>
      <div>
        <%= f.label :cnpj, "CNPJ / CPF", class: stock_label_class %>
        <div class="mt-2"><%= f.text_field :cnpj, class: stock_input_class %></div>
      </div>
      <div>
        <%= f.label :contact_name, "Contato", class: stock_label_class %>
        <div class="mt-2"><%= f.text_field :contact_name, class: stock_input_class %></div>
      </div>
      <div>
        <%= f.label :phone, "Telefone", class: stock_label_class %>
        <div class="mt-2"><%= f.telephone_field :phone, class: stock_input_class %></div>
      </div>
      <div>
        <%= f.label :email, "E-mail", class: stock_label_class %>
        <div class="mt-2"><%= f.email_field :email, class: stock_input_class %></div>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :notes, "Observações", class: stock_label_class %>
        <div class="mt-2"><%= f.textarea :notes, rows: 3, class: stock_input_class %></div>
      </div>
      <label class="flex items-center gap-x-3 sm:col-span-2">
        <%= f.check_box :active, class: "size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
        <span class="text-sm text-gray-700">Ativo</span>
      </label>
    </div>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <%= link_to "Cancelar", suppliers_path, class: stock_secondary_button %>
      <%= f.submit "Salvar fornecedor", class: stock_primary_button %>
    </div>
  <% end %>
</div>
