<% categories = @company.categories.includes(:subcategories).order(:id) %>
<% if expense_only? %>
  <%= render "partials/stock_subcategory_streams", selected: @subcategory.id %>
<% else %>
  <%= turbo_stream.replace "subcategory_select", partial: "partials/subcategory_select", locals: { categories: categories, selected: @subcategory.id } %>
<% end %>
<%= turbo_stream.replace "subcategory_form", partial: "partials/subcategory_form", locals: { subcategory: Subcategory.new, categories: expense_only? ? categories.where(is_income: false) : categories, expense_only: expense_only? } %>
